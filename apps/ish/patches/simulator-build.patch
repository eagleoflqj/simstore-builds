@@ -1,7 +1,6 @@
 #!/bin/bash
 
-# Try to figure out the user's PATH to pick up their installed utilities.
-export PATH="$PATH:$(sudo -u "$USER" -i printenv PATH)"
+# Use the toolchain prepared by the calling build recipe.
 
