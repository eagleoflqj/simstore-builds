+    if [[ $PLATFORM_NAME == iphonesimulator ]]; then
+        arch_args="$arch_args, '-target', '$ARCHS-apple-ios$IPHONEOS_DEPLOYMENT_TARGET-simulator', '-isysroot', '$SDKROOT'"
+    fi
     meson_arch=${ARCHS%% *}
     case "$meson_arch" in
         arm64) meson_arch=aarch64 ;;
@@ -36,7 +38,7 @@ if [[ $? -ne 0 ]]; then
