diff --git a/client/iOS/cmake/ExternalOpenH264.cmake b/client/iOS/cmake/ExternalOpenH264.cmake
index d360b69..22a4e0e 100644
--- a/client/iOS/cmake/ExternalOpenH264.cmake
+++ b/client/iOS/cmake/ExternalOpenH264.cmake
@@ -1,11 +1,20 @@
 include(ExternalProject)
 include(DepVersions)
 
-set(IOS_FLAGS "ENABLEPIC=Yes OS=ios ARCH=arm64 SDK_MIN=${CMAKE_OSX_DEPLOYMENT_TARGET}")
+set(IOS_FLAGS ENABLEPIC=Yes OS=ios ARCH=arm64 SDK_MIN=${CMAKE_OSX_DEPLOYMENT_TARGET})
+if(PLATFORM MATCHES "SIMULATOR")
+  list(APPEND IOS_FLAGS SDKTYPE=iPhoneSimulator
+       "CC=${CMAKE_C_COMPILER} -target arm64-apple-ios${CMAKE_OSX_DEPLOYMENT_TARGET}-simulator"
+       "CXX=${CMAKE_CXX_COMPILER} -target arm64-apple-ios${CMAKE_OSX_DEPLOYMENT_TARGET}-simulator")
+endif()
+
 ExternalProject_Add(
-  openh264 DOWNLOAD_EXTRACT_TIMESTAMP OFF GIT_REPOSITORY https://github.com/cisco/openh264.git GIT_TAG ${OPENH264_TAG}
-  GIT_SHALLOW TRUE CONFIGURE_COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different <SOURCE_DIR> <BINARY_DIR>
-  BUILD_COMMAND make ${IOS_FLAGS} LDFLAGS=-static-libstdc++ -j libraries
+  openh264 DOWNLOAD_EXTRACT_TIMESTAMP OFF
+  URL https://github.com/cisco/openh264/archive/${OPENH264_REVISION}.tar.gz
+  URL_HASH SHA256=${OPENH264_SHA256}
+  CONFIGURE_COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different <SOURCE_DIR> <BINARY_DIR>
+  BUILD_COMMAND make ${IOS_FLAGS} -j$ENV{CMAKE_BUILD_PARALLEL_LEVEL} libraries
   INSTALL_COMMAND make ${IOS_FLAGS} PREFIX=${DEPS_INSTALL_DIR} LIBDIR_NAME=${CMAKE_INSTALL_LIBDIR}
-                  SHAREDLIB_DIR=${DEPS_INSTALL_DIR}/${CMAKE_INSTALL_LIBDIR} -j install
+                  SHAREDLIB_DIR=${DEPS_INSTALL_DIR}/${CMAKE_INSTALL_LIBDIR}
+                  -j$ENV{CMAKE_BUILD_PARALLEL_LEVEL} install
 )
